<Window x:Class="ScreenForge.Windows.BackgroundEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arka plan" Width="920" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Margin="0,0,16,0" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#222836">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,16,16" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#2C3446">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,8,8" />
                                            <RectangleGeometry Rect="8,8,8,8" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>
                <Image x:Name="Preview" Stretch="Uniform" />
            </Grid>
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Arka plan" Style="{StaticResource Heading}" />
            <TextBlock x:Name="FileLabel" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,12" />

            <UniformGrid Columns="2" Margin="0,0,0,10">
                <Button x:Name="BtnRemove" Content="Kaldır" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                <Button x:Name="BtnColor" Content="Renk" Style="{StaticResource SecondaryButton}" />
            </UniformGrid>

            <StackPanel x:Name="ColorPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="Arka plan rengi" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                <WrapPanel x:Name="Swatches" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ColorWell" Width="36" Height="32" CornerRadius="6" Cursor="Hand"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            ToolTip="Özel renk" MouseLeftButtonUp="ColorWell_Click" />
                    <TextBox x:Name="HexBox" Grid.Column="1" Style="{StaticResource EditorTextBox}"
                             Margin="8,0,8,0" Height="32" FontSize="13"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="BtnCustomColor" Grid.Column="2" Content="Özel" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" />
                </Grid>
            </StackPanel>

            <Button x:Name="BtnImage" Content="Başka görüntü" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,8" />
            <Button x:Name="BtnReset" Content="Sıfırla" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Stretch" />

            <TextBlock x:Name="Hint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Sol tık konuyu, sağ tık arka planı işaretler. Maske yeniden hesaplanır." />
            <TextBlock x:Name="Status" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnSave" Content="Üzerine kaydet" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button x:Name="BtnSaveAs" Content="Farklı kaydet" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
