<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenForge</AssemblyName>
    <RootNamespace>ScreenForge</RootNamespace>
    <Version>1.2.8</Version>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>ScreenForge.App</StartupObject>
    <!-- NU1701: H.NotifyIcon/SkiaSharp.Views net4x uyumlu, WPF'de sorunsuz çalışır.
         WFO0003: DPI manifest WPF PerMonitorV2 için kasıtlı. CS0618: SKPath eski API gürültüsü. -->
    <NoWarn>$(NoWarn);NU1701;WFO0003;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Upload secret: /p:UploadSecret=... → env SCREENFORGE_UPLOAD_SECRET → repo kökü .env -->
  <PropertyGroup>
    <_UploadSecretFile>$(MSBuildThisFileDirectory)..\.env</_UploadSecretFile>
    <UploadSecret Condition="'$(UploadSecret)' == ''">$(SCREENFORGE_UPLOAD_SECRET)</UploadSecret>
  </PropertyGroup>

  <Target Name="ResolveUploadSecret" BeforeTargets="BeforeCompile;CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <PropertyGroup Condition="'$(UploadSecret)' == '' and Exists('$(_UploadSecretFile)')">
      <_EnvRaw>$([System.IO.File]::ReadAllText('$(_UploadSecretFile)'))</_EnvRaw>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UploadSecret)' == '' and '$(_EnvRaw)' != ''">
      <UploadSecret>$([System.Text.RegularExpressions.Regex]::Match($(_EnvRaw), '(?m)^SCREENFORGE_UPLOAD_SECRET=(.*)$').Groups[1].Value.Trim())</UploadSecret>
    </PropertyGroup>
    <PropertyGroup>
      <_UploadSecretEscaped>$([System.String]::Copy('$(UploadSecret)').Replace('\','\\').Replace('"','\"'))</_UploadSecretEscaped>
      <_GeneratedUploadSecret>$(IntermediateOutputPath)UploadSecret.g.cs</_GeneratedUploadSecret>
    </PropertyGroup>
    <!-- MSBuild'de ';' liste ayırıcıdır → satır sonlarında %3B kullan -->
    <ItemGroup>
      <_UploadSecretLines Include="namespace ScreenForge.Upload%3B" />
      <_UploadSecretLines Include="// Auto-generated by ScreenForge.csproj — do not edit." />
      <_UploadSecretLines Include="internal static class UploadSecret" />
      <_UploadSecretLines Include="{" />
      <_UploadSecretLines Include="    public const string Value = &quot;$(_UploadSecretEscaped)&quot;%3B" />
      <_UploadSecretLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_GeneratedUploadSecret)" Lines="@(_UploadSecretLines)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(_GeneratedUploadSecret)" />
      <FileWrites Include="$(_GeneratedUploadSecret)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app.png" />
    <Content Include="Models\u2netp.onnx" CopyToOutputDirectory="PreserveNewest" TargetPath="u2netp.onnx" Link="u2netp.onnx" />
    <Content Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai\1.8.79\lib\net6.0-windows10.0.17763.0\Microsoft.Windows.AI.Imaging.Projection.dll" Link="Microsoft.Windows.AI.Imaging.Projection.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Microsoft.Windows.AI.Imaging.Projection.dll" />
    <Content Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai\1.8.79\lib\net6.0-windows10.0.17763.0\Microsoft.Windows.AI.Projection.dll" Link="Microsoft.Windows.AI.Projection.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Microsoft.Windows.AI.Projection.dll" />
    <Content Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai\1.8.79\lib\net6.0-windows10.0.17763.0\Microsoft.Graphics.Imaging.Projection.dll" Link="Microsoft.Graphics.Imaging.Projection.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Microsoft.Graphics.Imaging.Projection.dll" />
    <Content Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai\1.8.79\lib\net6.0-windows10.0.17763.0\Microsoft.Windows.AI.ContentSafety.Projection.dll" Link="Microsoft.Windows.AI.ContentSafety.Projection.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Microsoft.Windows.AI.ContentSafety.Projection.dll" />
    <Content Include="$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\1.8.260803002\lib\net6.0-windows10.0.17763.0\Microsoft.WindowsAppRuntime.Bootstrap.Net.dll" Link="Microsoft.WindowsAppRuntime.Bootstrap.Net.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Microsoft.WindowsAppRuntime.Bootstrap.Net.dll" />
    <Content Include="$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\1.8.260803002\runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" Link="Microsoft.WindowsAppRuntime.Bootstrap.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Microsoft.WindowsAppRuntime.Bootstrap.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenForge.WindowsAI\ScreenForge.WindowsAI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.148.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
